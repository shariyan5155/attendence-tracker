        function switchTab(tabId) {
            ['calendar', 'analytics'].forEach(t => {
                document.getElementById(`tabContent-${t}`).classList.add('hidden');
                document.getElementById(`tabBtn-${t}`).className = "pb-3 text-sm font-semibold border-b-2 border-transparent text-slate-400 hover:text-slate-200 transition flex items-center space-x-2";
            });
            document.getElementById(`tabContent-${tabId}`).classList.remove('hidden');
            document.getElementById(`tabBtn-${tabId}`).className = "pb-3 text-sm font-bold border-b-2 border-indigo-500 text-indigo-400 transition flex items-center space-x-2";

            if (tabId === 'analytics') {
                populateSubjectDropdown();
            }
