        function toggleTheme(forceLight = false) {
            const body = document.body;
            const html = document.getElementById('htmlRoot');
            const icon = document.getElementById('themeIcon');
            
            if (forceLight || !body.classList.contains('light')) {
                body.classList.add('light');
                html.classList.add('light');
                body.className = "bg-gradient-to-br from-slate-100 via-indigo-50 to-slate-200 text-slate-900 min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white transition-colors duration-300 light";
                icon.className = "fa-solid fa-sun text-amber-500";
                localStorage.setItem('aik_theme', 'light');
            } else {
                body.classList.remove('light');
                html.classList.remove('light');
                body.className = "bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-900 text-slate-100 min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white transition-colors duration-300";
                icon.className = "fa-solid fa-moon text-xs";
                localStorage.setItem('aik_theme', 'dark');
