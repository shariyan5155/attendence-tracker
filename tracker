        function changeMonth(dir) {
            currentMonth += dir;
            if (currentMonth > 11) { currentMonth = 0; currentYear++; }
            if (currentMonth < 0) { currentMonth = 11; currentYear--; }
            renderCalendar();
        }

        function getSessionType(subjectName) {
            if (subjectName.includes("(L)")) return "Practical";
            if (subjectName.includes("(T)")) return "Tutorial";
            return "Lecture";
        }

        function getBatchSubjectsForDay(dayName) {
            const timetable = masterTimetables[currentUser.division] || {};
            const dayEntries = timetable[dayName] || [];
            let subjectsForBatch = [];

            dayEntries.forEach(entry => {
                const mapping = entry.name;
                if (mapping.ALL) {
                    subjectsForBatch.push(mapping.ALL);
                } else if (mapping[currentUser.batch]) {
                    subjectsForBatch.push(mapping[currentUser.batch]);
                }
            });
            return subjectsForBatch;
        }

        function renderCalendar() {
            document.getElementById('currentMonthYearLabel').innerText = `${monthsNames[currentMonth]} ${currentYear}`;
            const grid = document.getElementById('calendarGrid');
            grid.innerHTML = '';

            const firstDayIndex = new Date(currentYear, currentMonth, 1).getDay();
            const totalDays = new Date(currentYear, currentMonth + 1, 0).getDate();

            for (let i = 0; i < firstDayIndex; i++) {
                const emptyCell = document.createElement('div');
                emptyCell.className = "h-24 bg-slate-900/10 light:bg-slate-200/50 rounded-2xl border border-transparent";
                grid.appendChild(emptyCell);
            }

            for (let day = 1; day <= totalDays; day++) {
                const dateKey = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
                const dateObj = new Date(currentYear, currentMonth, day);
                const dayOfWeek = dateObj.getDay();
                const isWeekend = (dayOfWeek === 0 || dayOfWeek === 6);
                const isBeforeTerm = dateObj < termStartDate;

                if (!attendanceData[dateKey] && (isWeekend || isBeforeTerm)) {
                    attendanceData[dateKey] = { status: 'HOLIDAY', sessions: [] };
                }

                const cellData = attendanceData[dateKey];
                
                const cell = document.createElement('div');
                cell.className = `h-24 p-2.5 rounded-2xl border transition flex flex-col justify-between relative group shadow-2xs ${isBeforeTerm ? 'bg-slate-950/20 light:bg-slate-200/40 border-slate-900/40 opacity-40 cursor-not-allowed' : (isWeekend ? 'bg-slate-900/40 light:bg-slate-100 border-slate-800/80 light:border-slate-300 cursor-pointer hover:border-slate-600' : 'bg-slate-900/80 light:bg-white border-slate-800 light:border-slate-200 hover:border-indigo-500 hover:shadow-lg cursor-pointer')}`;
                
                if (!isBeforeTerm) {
                    cell.onclick = () => openSessionModal(dateKey, day);
                }

                let statusBadge = '';
                if (isBeforeTerm) {
                    statusBadge = '<span class="text-[10px] font-bold bg-slate-800 light:bg-slate-300 text-slate-500 px-1.5 py-0.5 rounded-md">Locked</span>';
                } else if (cellData) {
                    if (cellData.status === 'HOLIDAY') statusBadge = '<span class="text-[10px] font-bold bg-amber-500/20 text-amber-500 border border-amber-500/30 px-1.5 py-0.5 rounded-md">Holiday</span>';
                    else if (cellData.status === 'LEAVE') statusBadge = '<span class="text-[10px] font-bold bg-purple-500/20 text-purple-500 border border-purple-500/30 px-1.5 py-0.5 rounded-md">Leave</span>';
                    else if (cellData.status === 'VACATION') statusBadge = '<span class="text-[10px] font-bold bg-blue-500/20 text-blue-500 border border-blue-500/30 px-1.5 py-0.5 rounded-md">Vacation</span>';
                    else {
                        const presentCount = cellData.sessions.filter(s => s.present).length;
                        const totalCount = cellData.sessions.length;
                        statusBadge = `<span class="text-[10px] bg-indigo-500/20 text-indigo-400 border border-indigo-500/30 px-1.5 py-0.5 rounded-md font-bold">${presentCount}/${totalCount}</span>`;
                    }
                }

                cell.innerHTML = `
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold ${isWeekend ? 'text-rose-400' : ''}">${day}</span>
                        ${statusBadge}
                    </div>
                    <div class="text-[10px] text-slate-400 truncate font-medium">
                        ${isBeforeTerm ? 'Before Term' : (cellData && cellData.sessions ? cellData.sessions.map(s => s.subject).join(', ') : (isWeekend ? 'Weekend (Click to schedule)' : ''))}
                    </div>
                `;
                grid.appendChild(cell);
            }
        }

        function openSessionModal(dateKey, dayNum) {
            selectedDateKey = dateKey;
            document.getElementById('modalDateTitle').innerText = `Attendance for ${monthsNames[currentMonth]} ${dayNum}, ${currentYear}`;
            document.getElementById('sessionModal').classList.remove('hidden');

            const dateObj = new Date(dateKey);
            const dayName = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][dateObj.getDay()];
            const isWeekend = (dateObj.getDay() === 0 || dateObj.getDay() === 6);
            
            if (!attendanceData[dateKey]) {
                const batchSubjects = isWeekend ? [] : getBatchSubjectsForDay(dayName);
                attendanceData[dateKey] = {
                    status: isWeekend ? 'HOLIDAY' : 'REGULAR',
                    sessions: batchSubjects.map(sub => ({ subject: sub, present: true }))
                };
            }

            document.getElementById('dayStatusSelect').value = attendanceData[dateKey].status;
            renderSessionsList();
        }

        function closeSessionModal() {
            document.getElementById('sessionModal').classList.add('hidden');
            selectedDateKey = null;
            renderCalendar();
            updateOverallStats();
        }

        function updateDayStatus(status) {
            if (attendanceData[selectedDateKey]) {
                attendanceData[selectedDateKey].status = status;
                if (status !== 'REGULAR') {
                    attendanceData[selectedDateKey].sessions = [];
                } else {
                    const dateObj = new Date(selectedDateKey);
                    const dayName = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][dateObj.getDay()];
                    const batchSubjects = getBatchSubjectsForDay(dayName);
                    attendanceData[selectedDateKey].sessions = batchSubjects.map(sub => ({ subject: sub, present: true }));
                }
                renderSessionsList();
            }
        }

        function renderSessionsList() {
            const container = document.getElementById('sessionsContainer');
            container.innerHTML = '';
            const cellData = attendanceData[selectedDateKey];

            if (cellData.status !== 'REGULAR') {
                container.innerHTML = `<p class="text-xs text-slate-400 py-6 text-center italic font-medium">No sessions scheduled due to active day status (${cellData.status}). Change status to Regular to add sessions.</p>`;
                return;
            }

            if (!cellData.sessions || cellData.sessions.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-4 space-y-3">
                        <p class="text-xs text-slate-400 italic">No default timetable sessions for this day (e.g. Working Saturday).</p>
                        <button onclick="addCustomSession()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs rounded-xl transition shadow-md">
                            <i class="fa-solid fa-plus mr-1"></i> Add Session / Practical
                        </button>
                    </div>`;
                return;
            }

            let htmlContent = '';
            cellData.sessions.forEach((session, index) => {
                const type = getSessionType(session.subject);
                let badgeColor = "bg-indigo-500/10 text-indigo-400 border-indigo-500/20";
                if (type === "Practical") badgeColor = "bg-emerald-500/10 text-emerald-400 border-emerald-500/20";
                if (type === "Tutorial") badgeColor = "bg-purple-500/10 text-purple-400 border-purple-500/20";

                htmlContent += `
                    <div class="flex items-center justify-between p-3.5 bg-slate-900/90 light:bg-white rounded-2xl border border-slate-800 light:border-slate-200 shadow-2xs">
                        <div class="flex items-center space-x-3">
                            <span class="text-xs font-bold px-2.5 py-1 rounded-lg border ${badgeColor}">${type}</span>
                            <span class="text-sm font-bold">${session.subject}</span>
                        </div>
                        <div class="flex items-center space-x-3">
                            <label class="relative inline-flex items-center cursor-pointer">
