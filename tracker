                        </div>
                    </div>
                `;
            });

            htmlContent += `
                <div class="pt-2 text-right">
                    <button onclick="addCustomSession()" class="px-3 py-1.5 bg-slate-800 light:bg-slate-200 hover:bg-slate-700 text-indigo-300 light:text-indigo-700 font-semibold text-xs rounded-xl transition border border-slate-700 light:border-slate-300">
                        <i class="fa-solid fa-plus mr-1"></i> Add Another Class
                    </button>
                </div>`;

            container.innerHTML = htmlContent;
        }

        function addCustomSession() {
            const subjectName = prompt("Enter Subject Name (e.g., PCC, WDL (L), EM1):");
            if (subjectName && subjectName.trim() !== "") {
                if (!attendanceData[selectedDateKey].sessions) {
                    attendanceData[selectedDateKey].sessions = [];
                }
                attendanceData[selectedDateKey].sessions.push({ subject: subjectName.trim().toUpperCase(), present: true });
                renderSessionsList();
            }
        }

        function removeSession(index) {
            if (attendanceData[selectedDateKey] && attendanceData[selectedDateKey].sessions) {
                attendanceData[selectedDateKey].sessions.splice(index, 1);
                renderSessionsList();
            }
        }

        function toggleSessionPresent(index) {
            if (attendanceData[selectedDateKey] && attendanceData[selectedDateKey].sessions[index]) {
                attendanceData[selectedDateKey].sessions[index].present = !attendanceData[selectedDateKey].sessions[index].present;
                renderSessionsList();
            }
        }

        function markAllSessions(status) {
            if (attendanceData[selectedDateKey] && attendanceData[selectedDateKey].sessions) {
                attendanceData[selectedDateKey].sessions.forEach(s => s.present = status);
                renderSessionsList();
            }
        }

        function saveDayAttendance() {
            localStorage.setItem('aik_master_attendance', JSON.stringify(attendanceData));
            closeSessionModal();
            updateOverallStats();
        }

        function updateOverallStats() {
            let totalClasses = 0;
            let attendedClasses = 0;
            let sortedDates = Object.keys(attendanceData).sort();
            let currentStreak = 0;
            let tempStreak = 0;

            sortedDates.forEach(dateKey => {
                const day = attendanceData[dateKey];
                if (day.status === 'REGULAR' && day.sessions && day.sessions.length > 0) {
                    let dayTotal = day.sessions.length;
                    let dayAttended = day.sessions.filter(s => s.present).length;
                    
                    totalClasses += dayTotal;
                    attendedClasses += dayAttended;

                    // Streak calculation logic
                    if (dayTotal > 0 && dayAttended === dayTotal) {
                        tempStreak++;
                        currentStreak = tempStreak;
                    } else if (dayAttended < dayTotal) {
                        tempStreak = 0;
                    }
                }
            });

            const percentage = totalClasses > 0 ? Math.round((attendedClasses / totalClasses) * 100) : 0;
            document.getElementById('overallPercentage').innerText = `${percentage}%`;
            document.getElementById('streakValue').innerText = `${currentStreak} Days`;

            // Safe Bunk / Deficit Calculation (Target = 75%)
            // Formula: Attended / Total >= 0.75 => Attended >= 0.75*Total
            // Safe Bunks you can miss: (Attended - 0.75 * Total) / 0.75
            // Deficit classes to attend: (0.75 * Total - Attended) / 0.25
            const safeBunkEl = document.getElementById('safeBunkValue');
            const safeBunkAdvice = document.getElementById('safeBunkAdvice');

            if (totalClasses === 0) {
                safeBunkEl.innerText = "0 Classes";
                safeBunkAdvice.innerText = "Start logging attendance";
            } else {
                const ratio = attendedClasses / totalClasses;
                if (ratio >= 0.75) {
                    const safeCount = Math.floor((attendedClasses - 0.75 * totalClasses) / 0.75);
                    safeBunkEl.innerText = `${safeCount} Classes`;
                    safeBunkAdvice.innerText = "Safe to skip before 75%";
                } else {
                    const deficitCount = Math.ceil((0.75 * totalClasses - attendedClasses) / 0.25);
                    safeBunkEl.innerText = `${deficitCount} Classes`;
                    safeBunkAdvice.innerText = "Needed to reach 75%";
                }
            }
        }

        function openSummaryModal() {
            let totalClasses = 0;
            let attendedClasses = 0;

            Object.values(attendanceData).forEach(day => {
                if (day.status === 'REGULAR' && day.sessions) {
                    day.sessions.forEach(s => {
                        totalClasses++;
                        if (s.present) attendedClasses++;
                    });
                }
            });

            const percentage = totalClasses > 0 ? Math.round((attendedClasses / totalClasses) * 100) : 0;

            document.getElementById('sumModalName').innerText = currentUser ? currentUser.name : '-';
            document.getElementById('sumModalRoll').innerText = `Roll: ${currentUser ? currentUser.rollNo : '-'}`;
            document.getElementById('sumModalDiv').innerText = currentUser ? currentUser.division : '-';
            document.getElementById('sumModalBatch').innerText = currentUser ? currentUser.batch : '-';
            document.getElementById('sumModalPercentage').innerText = `${percentage}%`;
            document.getElementById('sumModalAttended').innerText = attendedClasses;
            document.getElementById('sumModalTotal').innerText = totalClasses;
            document.getElementById('sumModalProgressBar').style.width = `${percentage}%`;

            const adviceBox = document.getElementById('sumModalAdvice');

            if (percentage >= 75) {
                adviceBox.className = "p-4 rounded-xl bg-emerald-950/60 light:bg-emerald-100 border border-emerald-800/50 light:border-emerald-300 text-emerald-300 light:text-emerald-800 text-xs font-semibold flex items-center space-x-3";
                adviceBox.innerHTML = '<i class="fa-solid fa-circle-check text-base text-emerald-400"></i>';
                adviceBox.appendChild(Object.assign(document.createElement('span'), { textContent: "Great job! Your attendance is above the safe 75% threshold." }));
            } else {
                adviceBox.className = "p-4 rounded-xl bg-rose-950/60 light:bg-rose-100 border border-rose-800/50 light:border-rose-300 text-rose-300 light:text-rose-800 text-xs font-semibold flex items-center space-x-3";
                adviceBox.innerHTML = '<i class="fa-solid fa-triangle-exclamation text-base text-rose-400"></i>';
                adviceBox.appendChild(Object.assign(document.createElement('span'), { textContent: "Warning: Your attendance is currently below the 75% required quota." }));
            }

            document.getElementById('summaryModal').classList.remove('hidden');
        }

        function closeSummaryModal() {
            document.getElementById('summaryModal').classList.add('hidden');
        }

        function populateSubjectDropdown() {
            const select = document.getElementById('analyticsSubjectSelect');
            select.innerHTML = '<option value="">-- Choose a Subject --</option>';
            
            const subjectsSet = new Set();
            ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"].forEach(dayName => {
                const batchList = getBatchSubjectsForDay(dayName);
                batchList.forEach(sub => subjectsSet.add(sub));
            });

            Object.values(attendanceData).forEach(day => {
                if (day.status === 'REGULAR' && day.sessions) {
                    day.sessions.forEach(s => subjectsSet.add(s.subject));
                }
            });

            subjectsSet.forEach(sub => {
                const opt = document.createElement('option');
                opt.value = sub;
                opt.innerText = sub;
                select.appendChild(opt);
            });
        }

        function renderSubjectAnalytics() {
            const subject = document.getElementById('analyticsSubjectSelect').value;
            const detailView = document.getElementById('analyticsDetailView');
            const placeholder = document.getElementById('analyticsPlaceholder');

            if (!subject) {
                detailView.classList.add('hidden');
                placeholder.classList.remove('hidden');
                return;
            }

            placeholder.classList.add('hidden');
            detailView.classList.remove('hidden');

            let subTotal = 0;
            let subAttended = 0;

            Object.values(attendanceData).forEach(day => {
                if (day.status === 'REGULAR' && day.sessions) {
                    day.sessions.forEach(s => {
                        if (s.subject === subject) {
                            subTotal++;
                            if (s.present) subAttended++;
                        }
                    });
                }
            });

            const subPercentage = subTotal > 0 ? Math.round((subAttended / subTotal) * 100) : 0;

            document.getElementById('selectedSubjectName').innerText = subject;
            document.getElementById('selectedSubjectPercentage').innerText = `${subPercentage}%`;
            document.getElementById('statSubjectAttended').innerText = subAttended;
            document.getElementById('statSubjectTotal').innerText = subTotal;
            
            const statusEl = document.getElementById('statSubjectStatus');
            
            if (subTotal === 0) {
                statusEl.innerText = "No lectures conducted yet";
                statusEl.className = "text-sm font-bold text-slate-400 mt-2";
            } else if (subPercentage >= 75) {
                statusEl.innerText = "Safe Zone (≥ 75%)";
                statusEl.className = "text-sm font-bold text-emerald-400 light:text-emerald-600 mt-2";
            } else {
                statusEl.innerText = "Attendance Shortage (< 75%)";
                statusEl.className = "text-sm font-bold text-rose-400 light:text-rose-600 mt-2";
            }
        }

        function resetAnalyticsDropdown() {
            document.getElementById('analyticsSubjectSelect').value = "";
            renderSubjectAnalytics();
        }
    </script>
</body>
</html>