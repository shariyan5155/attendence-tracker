<!DOCTYPE html>
<html lang="en" id="htmlRoot">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AIKTC Campus Attendance Tracker</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .glass-card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .light .glass-card {
            background: rgba(255, 255, 255, 0.8);
            border: 1px solid rgba(0, 0, 0, 0.06);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
        }
        .glass-panel {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .light .glass-panel {
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(0, 0, 0, 0.08);
        }
    </style>
</head>
<body class="bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-900 text-slate-100 min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white transition-colors duration-300" id="bodyTheme">

    <!-- Top Navigation Bar -->
    <header class="glass-panel border-b border-slate-800 light:border-slate-200 sticky top-0 z-30 shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-12 h-12 rounded-full bg-white p-1 shadow-md border border-indigo-500/30 flex items-center justify-center overflow-hidden">
                    <img src="data:image/jpeg;base64,/9j/4AAQSkZJRgABAQEASABIAAD/2wBDAP//////////////////////////////////////////////////////////////////////////////////////wgALCAABAAEBAREA/8QAFBABAAAAAAAAAAAAAAAAAAAAAP/aAAgBAQABPxA=" alt="AIKTC Logo" class="w-full h-full object-contain">
                </div>
                <div>
                    <h2 class="font-bold text-base leading-tight">AIKTC Attendance</h2>
                    <p class="text-xs font-semibold text-indigo-400" id="userBadgeText">Loading profile...</p>
                </div>
            </div>
            <div class="flex items-center space-x-3">
                <!-- Theme Toggle -->
                <button onclick="toggleTheme()" class="p-2.5 rounded-xl bg-slate-800/80 light:bg-slate-200 hover:bg-slate-700 text-slate-300 light:text-slate-700 transition border border-slate-700 light:border-slate-300">
                    <i id="themeIcon" class="fa-solid fa-moon text-xs"></i>
                </button>
                <a href="index.html" class="text-xs font-semibold bg-slate-800/80 light:bg-slate-200 hover:bg-slate-700 light:hover:bg-slate-300 text-slate-200 light:text-slate-800 px-3.5 py-2.5 rounded-xl transition flex items-center space-x-1.5 border border-slate-700 light:border-slate-300 shadow-sm">
                    <i class="fa-solid fa-arrow-left text-pink-400"></i>
                    <span>Switch Profile</span>
                </a>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1 w-full space-y-8">
        
        <!-- Dashboard Stats Row (Stats + Safe Bunk + Streak) -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Overall Percentage Card -->
            <div onclick="openSummaryModal()" class="glass-card p-6 rounded-3xl shadow-xl hover:border-indigo-500/50 transition cursor-pointer flex items-center justify-between group bg-gradient-to-br from-slate-900/90 light:from-white via-indigo-950/40 light:via-indigo-50 to-slate-900/90 light:to-white">
                <div class="space-y-1">
                    <div class="flex items-center space-x-2">
                        <span class="text-xs font-bold uppercase tracking-wider text-indigo-500">Overall Rate</span>
                        <i class="fa-solid fa-circle-info text-slate-400 group-hover:text-indigo-500 transition text-xs"></i>
                    </div>
                    <h3 class="text-3xl font-extrabold tracking-tight" id="overallPercentage">0%</h3>
                    <p class="text-xs text-slate-400 font-medium">Click for summary</p>
                </div>
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-indigo-500 to-purple-600 text-white flex items-center justify-center text-xl shadow-lg shadow-indigo-500/30 group-hover:scale-105 transition duration-200">
                    <i class="fa-solid fa-chart-pie"></i>
                </div>
            </div>

            <!-- Safe Bunk Calculator Card -->
            <div class="glass-card p-6 rounded-3xl shadow-xl flex items-center justify-between bg-gradient-to-br from-slate-900/90 light:from-white via-emerald-950/30 light:via-emerald-50 to-slate-900/90 light:to-white">
                <div class="space-y-1">
                    <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">Safe Bunk / Deficit</span>
                    <h3 class="text-2xl font-extrabold tracking-tight" id="safeBunkValue">0 Classes</h3>
                    <p class="text-xs text-slate-400 font-medium" id="safeBunkAdvice">Maintaining 75% target</p>
                </div>
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-emerald-500 to-teal-600 text-white flex items-center justify-center text-xl shadow-lg shadow-emerald-500/30">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
            </div>

            <!-- Streak Counter Card -->
            <div class="glass-card p-6 rounded-3xl shadow-xl flex items-center justify-between bg-gradient-to-br from-slate-900/90 light:from-white via-amber-950/30 light:via-amber-50 to-slate-900/90 light:to-white">
                <div class="space-y-1">
                    <span class="text-xs font-bold uppercase tracking-wider text-amber-400">Attendance Streak</span>
                    <h3 class="text-3xl font-extrabold tracking-tight" id="streakValue">0 Days</h3>
                    <p class="text-xs text-slate-400 font-medium">Consecutive present days</p>
                </div>
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-amber-500 to-orange-600 text-white flex items-center justify-center text-xl shadow-lg shadow-amber-500/30">
                    <i class="fa-solid fa-fire"></i>
                </div>
            </div>
        </div>

        <!-- Tabs Navigation -->
        <div class="border-b border-slate-800 light:border-slate-200 flex space-x-8">
            <button onclick="switchTab('calendar')" id="tabBtn-calendar" class="pb-3 text-sm font-bold border-b-2 border-indigo-500 text-indigo-400 transition flex items-center space-x-2">
                <i class="fa-solid fa-calendar-days"></i>
                <span>Calendar & Tracker</span>
            </button>
            <button onclick="switchTab('analytics')" id="tabBtn-analytics" class="pb-3 text-sm font-semibold border-b-2 border-transparent text-slate-400 hover:text-slate-200 transition flex items-center space-x-2">
                <i class="fa-solid fa-chart-bar"></i>
                <span>Subject Analytics</span>
            </button>
        </div>

        <!-- TAB 1: CALENDAR VIEW -->
        <div id="tabContent-calendar" class="space-y-6">
            <div class="glass-card rounded-3xl shadow-xl p-6 sm:p-8">
                <div class="flex items-center justify-between mb-6">
                    <div class="flex items-center space-x-3">
                        <button onclick="changeMonth(-1)" class="p-2.5 rounded-xl bg-slate-800 light:bg-slate-200 border border-slate-700 light:border-slate-300 hover:bg-slate-700 transition shadow-xs"><i class="fa-solid fa-chevron-left text-xs"></i></button>
                        <h3 id="currentMonthYearLabel" class="text-xl font-extrabold">September 2026</h3>
                        <button onclick="changeMonth(1)" class="p-2.5 rounded-xl bg-slate-800 light:bg-slate-200 border border-slate-700 light:border-slate-300 hover:bg-slate-700 transition shadow-xs"><i class="fa-solid fa-chevron-right text-xs"></i></button>
                    </div>
                    <div class="text-xs font-semibold text-indigo-300 bg-indigo-950/60 light:bg-indigo-100 light:text-indigo-800 px-3 py-1.5 rounded-lg border border-indigo-800/50 light:border-indigo-200 hidden sm:block">Term starts Sep 1, 2026 • Sat/Sun default holiday</div>
                </div>

                <!-- Calendar Grid Header -->
                <div class="grid grid-cols-7 gap-2.5 text-center text-xs font-bold text-slate-400 uppercase mb-3">
                    <div class="text-rose-400">Sun</div><div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div class="text-rose-400">Sat</div>
                </div>
                <!-- Calendar Days Container -->
                <div id="calendarGrid" class="grid grid-cols-7 gap-2.5"></div>
            </div>

            <!-- Daily Session Editor Modal Area -->
            <div id="sessionModal" class="hidden glass-card rounded-3xl shadow-2xl p-6 sm:p-8 space-y-5 relative animate-fadeIn border-indigo-500/30">
                <div class="flex items-center justify-between border-b border-slate-800 light:border-slate-200 pb-4">
                    <div>
                        <h3 class="font-bold text-lg" id="modalDateTitle">Attendance for Sep 1, 2026</h3>
                        <p class="text-xs text-slate-400">Configure status and manage session checkboxes below</p>
                    </div>
                    <button onclick="closeSessionModal()" class="text-slate-400 hover:text-white p-2 rounded-lg hover:bg-slate-800 transition"><i class="fa-solid fa-xmark text-lg"></i></button>
                </div>

                <div class="flex items-center space-x-4 py-2">
                    <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Day Status:</span>
                    <select id="dayStatusSelect" onchange="updateDayStatus(this.value)" class="px-4 py-2 rounded-xl bg-slate-900 light:bg-slate-100 border border-slate-700 light:border-slate-300 text-sm font-semibold focus:ring-2 focus:ring-indigo-500 outline-none">
                        <option value="REGULAR">Regular Working Day</option>
                        <option value="HOLIDAY">College Holiday</option>
                        <option value="LEAVE">Official Leave / Event</option>
                        <option value="VACATION">Vacation / Break</option>
                    </select>
                </div>

                <div id="sessionsContainer" class="space-y-3">
                    <!-- Populated dynamically -->
                </div>

                <div class="flex items-center justify-between pt-4 border-t border-slate-800 light:border-slate-200">
                    <div class="space-x-2">
                        <button onclick="markAllSessions(true)" class="px-3.5 py-2 bg-emerald-950/60 light:bg-emerald-100 text-emerald-400 light:text-emerald-800 border border-emerald-800/50 light:border-emerald-300 font-semibold text-xs rounded-xl transition">Mark All Present</button>
                        <button onclick="markAllSessions(false)" class="px-3.5 py-2 bg-rose-950/60 light:bg-rose-100 text-rose-400 light:text-rose-800 border border-rose-800/50 light:border-rose-300 font-semibold text-xs rounded-xl transition">Mark All Absent</button>
                    </div>
                    <button onclick="saveDayAttendance()" class="px-6 py-2.5 bg-gradient-to-r from-indigo-500 to-purple-600 hover:opacity-90 text-white font-bold text-sm rounded-xl shadow-lg shadow-indigo-600/25 transition">Save Attendance</button>
                </div>
            </div>
        </div>

        <!-- TAB 2: SUBJECT ANALYTICS -->
        <div id="tabContent-analytics" class="hidden space-y-6">
            <div class="glass-card rounded-3xl shadow-xl p-6 sm:p-8 space-y-6">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h3 class="text-xl font-extrabold">Subject-wise Analytics</h3>
                        <p class="text-xs text-slate-400">Track individual subject performance and attendance quotas</p>
                    </div>
                    <div class="flex items-center space-x-2">
                        <select id="analyticsSubjectSelect" onchange="renderSubjectAnalytics()" class="px-4 py-2.5 rounded-xl bg-slate-900 light:bg-slate-100 border border-slate-700 light:border-slate-300 text-sm font-semibold focus:ring-2 focus:ring-indigo-500 outline-none min-w-[240px]">
                            <option value="">-- Choose a Subject --</option>
                        </select>
                        <button onclick="resetAnalyticsDropdown()" class="px-3.5 py-2.5 bg-slate-800 light:bg-slate-200 hover:bg-slate-700 rounded-xl text-sm font-semibold transition border border-slate-700 light:border-slate-300" title="Reset selection">
                            <i class="fa-solid fa-rotate-right"></i>
                        </button>
                    </div>
                </div>

                <div id="analyticsDetailView" class="hidden p-6 bg-slate-900/80 light:bg-slate-100 rounded-2xl border border-slate-800 light:border-slate-200 space-y-4">
                    <div class="flex items-center justify-between">
                        <h4 class="font-bold text-lg" id="selectedSubjectName">Subject Title</h4>
                        <span class="px-3.5 py-1.5 bg-gradient-to-r from-indigo-500 to-purple-600 text-white font-bold rounded-full text-sm shadow-sm" id="selectedSubjectPercentage">0%</span>
                    </div>
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-2">
                        <div class="bg-slate-950/60 light:bg-white p-4 rounded-xl border border-slate-800 light:border-slate-200 shadow-2xs">
                            <p class="text-xs font-semibold text-slate-400 uppercase">Sessions Attended</p>
                            <p class="text-2xl font-extrabold text-emerald-400 light:text-emerald-600 mt-1" id="statSubjectAttended">0</p>
                        </div>
                        <div class="bg-slate-950/60 light:bg-white p-4 rounded-xl border border-slate-800 light:border-slate-200 shadow-2xs">
                            <p class="text-xs font-semibold text-slate-400 uppercase">Total Conducted</p>
                            <p class="text-2xl font-extrabold mt-1" id="statSubjectTotal">0</p>
                        </div>
                        <div class="bg-slate-950/60 light:bg-white p-4 rounded-xl border border-slate-800 light:border-slate-200 shadow-2xs col-span-2 sm:col-span-1">
                            <p class="text-xs font-semibold text-slate-400 uppercase">Status Assessment</p>
                            <p class="text-sm font-bold mt-2" id="statSubjectStatus">Good Standing</p>
                        </div>
                    </div>
                </div>

                <div id="analyticsPlaceholder" class="text-center py-16 text-slate-400">
                    <i class="fa-solid fa-arrow-pointer text-4xl mb-3 text-indigo-400/50"></i>
                    <p class="text-sm font-medium">Please select a subject from the dropdown above to view its detailed analytics.</p>
                </div>
            </div>
        </div>

    </main>

    <!-- COMPREHENSIVE SUMMARY POPUP MODAL -->
    <div id="summaryModal" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
        <div class="glass-panel rounded-3xl shadow-2xl max-w-lg w-full p-6 sm:p-8 space-y-6 transform transition-all border-slate-700">
            <div class="flex items-center justify-between border-b border-slate-800 light:border-slate-200 pb-4">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-xl bg-indigo-500/20 text-indigo-400 flex items-center justify-center font-bold border border-indigo-500/30">
                        <i class="fa-solid fa-file-invoice"></i>
                    </div>
                    <h3 class="font-bold text-lg">Attendance Summary</h3>
                </div>
                <button onclick="closeSummaryModal()" class="text-slate-400 hover:text-white p-2 rounded-lg hover:bg-slate-800 transition"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>

            <div class="space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div class="bg-slate-900/80 light:bg-slate-100 p-4 rounded-2xl border border-slate-800 light:border-slate-200">
                        <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Student Profile</p>
                        <p class="text-sm font-bold mt-1" id="sumModalName">-</p>
                        <p class="text-xs text-indigo-400 font-semibold" id="sumModalRoll">-</p>
                    </div>
                    <div class="bg-slate-900/80 light:bg-slate-100 p-4 rounded-2xl border border-slate-800 light:border-slate-200">
                        <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Active Division & Batch</p>
                        <p class="text-sm font-bold mt-1" id="sumModalDiv">-</p>
                        <p class="text-xs text-emerald-400 font-semibold" id="sumModalBatch">-</p>
                    </div>
                </div>

                <div class="bg-gradient-to-br from-indigo-950 via-slate-900 to-purple-950 text-white p-6 rounded-2xl shadow-lg space-y-3 border border-indigo-500/30">
                    <div class="flex justify-between items-center">
                        <span class="text-xs font-semibold text-indigo-300 uppercase tracking-wider">Overall Performance Score</span>
                        <span class="text-2xl font-extrabold" id="sumModalPercentage">0%</span>
                    </div>
                    <div class="w-full bg-slate-800 h-2.5 rounded-full overflow-hidden">
                        <div id="sumModalProgressBar" class="bg-gradient-to-r from-indigo-500 to-pink-500 h-full w-0 transition-all duration-500"></div>
                    </div>
                    <div class="flex justify-between text-xs text-indigo-300 pt-1">
                        <span>Attended: <strong class="text-white" id="sumModalAttended">0</strong></span>
                        <span>Total Tracked: <strong class="text-white" id="sumModalTotal">0</strong></span>
                    </div>
                </div>

                <div id="sumModalAdvice" class="p-4 rounded-xl bg-emerald-950/60 light:bg-emerald-100 border border-emerald-800/50 light:border-emerald-300 text-emerald-300 light:text-emerald-800 text-xs font-medium flex items-center space-x-3">
                    <i class="fa-solid fa-circle-check text-base text-emerald-400"></i>
                    <span id="sumModalAdviceText">Your attendance is currently meeting institutional criteria. Keep up the good work!</span>
                </div>
            </div>

            <button onclick="closeSummaryModal()" class="w-full py-3 bg-slate-800 light:bg-slate-200 hover:bg-slate-700 light:hover:bg-slate-300 font-semibold rounded-xl text-sm transition shadow-md border border-slate-700 light:border-slate-300">Close Summary</button>
        </div>
    </div>

