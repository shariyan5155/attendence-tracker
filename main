            },
            "DIV I (CIVIL)": {
                "Mon": ["EP L", "PCC", "EM-I", "SPAP", "SD/MENT"],
                "Tue": ["EP", "EG L", "EM-I", "PCC", "UHV"],
                "Wed": ["UHV", "PCC", "CS", "EM-I"],
                "Thu": ["EG L", "EP", "SPAP"],
                "Fri": ["EM-I", "EP", "PCC", "CS", "TECHNO"],
                "Sat": [], "Sun": []
            }
        };

        let currentUser = null; 
        let attendanceData = JSON.parse(localStorage.getItem('aik_attendance')) || {};
        let currentYear = 2026;
        let currentMonth = 8;
        let selectedDateKey = null;

        const monthsNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

        document.addEventListener('DOMContentLoaded', () => {
            // Initialize divisions for the default selected branch on load
            onBranchChange();

            const setupForm = document.getElementById('setupForm');
            setupForm.addEventListener('submit', (e) => {
                e.preventDefault();
                currentUser = {
                    name: document.getElementById('studentNameInput').value,
                    rollNo: document.getElementById('rollNoInput').value,
                    branch: document.getElementById('branchInput').value,
                    division: document.getElementById('divisionInput').value
                };
                localStorage.setItem('aik_user', JSON.stringify(currentUser));
                toggleAppView();
            });

            document.getElementById('landingScreen').classList.remove('hidden');
            document.getElementById('mainApp').classList.add('hidden');
        });

        function onBranchChange() {
            const branchSelect = document.getElementById('branchInput');
            const divisionSelect = document.getElementById('divisionInput');
            const selectedBranch = branchSelect.value;
            
            divisionSelect.innerHTML = '';
            const availableDivisions = branchDivisionsMap[selectedBranch] || [];
            
            availableDivisions.forEach(div => {
                const opt = document.createElement('option');
                opt.value = div.value;
                opt.innerText = div.text;
                opt.className = "bg-slate-900";
                divisionSelect.appendChild(opt);
            });
        }

        function toggleAppView() {
            document.getElementById('landingScreen').classList.add('hidden');
            document.getElementById('mainApp').classList.remove('hidden');
            document.getElementById('userBadgeText').innerText = `${currentUser.division} • Roll: ${currentUser.rollNo}`;
            
            populateSubjectDropdown();
            renderCalendar();
            updateOverallStats();
        }

        function switchUserModal() {
            document.getElementById('landingScreen').classList.remove('hidden');
            document.getElementById('mainApp').classList.add('hidden');
        }

        function switchTab(tabId) {
            ['calendar', 'analytics'].forEach(t => {
                document.getElementById(`tabContent-${t}`).classList.add('hidden');
                document.getElementById(`tabBtn-${t}`).className = "pb-3 text-sm font-semibold border-b-2 border-transparent text-slate-400 hover:text-slate-200 transition flex items-center space-x-2";
            });
            document.getElementById(`tabContent-${tabId}`).classList.remove('hidden');
            document.getElementById(`tabBtn-${tabId}`).className = "pb-3 text-sm font-bold border-b-2 border-indigo-500 text-indigo-400 transition flex items-center space-x-2";
        }

        function changeMonth(dir) {
            currentMonth += dir;
            if (currentMonth > 11) { currentMonth = 0; currentYear++; }
            if (currentMonth < 0) { currentMonth = 11; currentYear--; }
            renderCalendar();
        }

        function renderCalendar() {
            document.getElementById('currentMonthYearLabel').innerText = `${monthsNames[currentMonth]} ${currentYear}`;
            const grid = document.getElementById('calendarGrid');
            grid.innerHTML = '';

            const firstDayIndex = new Date(currentYear, currentMonth, 1).getDay();
            const totalDays = new Date(currentYear, currentMonth + 1, 0).getDate();

            for (let i = 0; i < firstDayIndex; i++) {
                const emptyCell = document.createElement('div');
                emptyCell.className = "h-24 bg-slate-900/20 rounded-2xl border border-transparent";
                grid.appendChild(emptyCell);
            }

            for (let day = 1; day <= totalDays; day++) {
                const dateKey = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
                const dateObj = new Date(currentYear, currentMonth, day);
                const dayOfWeek = dateObj.getDay();
                const isWeekend = (dayOfWeek === 0 || dayOfWeek === 6);

                if (!attendanceData[dateKey] && isWeekend) {
                    attendanceData[dateKey] = { status: 'HOLIDAY', sessions: [] };
                }

                const cellData = attendanceData[dateKey];
                
                const cell = document.createElement('div');
                cell.className = `h-24 p-2.5 rounded-2xl border transition cursor-pointer flex flex-col justify-between relative group shadow-2xs ${isWeekend ? 'bg-slate-900/40 border-slate-800/80' : 'bg-slate-900/80 border-slate-800 hover:border-indigo-500 hover:shadow-lg'}`;
                cell.onclick = () => openSessionModal(dateKey, day);

                let statusBadge = '';
                if (cellData) {
                    if (cellData.status === 'HOLIDAY') statusBadge = '<span class="text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30 px-1.5 py-0.5 rounded-md">Holiday</span>';
                    else if (cellData.status === 'LEAVE') statusBadge = '<span class="text-[10px] font-bold bg-purple-500/20 text-purple-300 border border-purple-500/30 px-1.5 py-0.5 rounded-md">Leave</span>';
                    else if (cellData.status === 'VACATION') statusBadge = '<span class="text-[10px] font-bold bg-blue-500/20 text-blue-300 border border-blue-500/30 px-1.5 py-0.5 rounded-md">Vacation</span>';
                    else {
                        const presentCount = cellData.sessions.filter(s => s.present).length;
                        const totalCount = cellData.sessions.length;
                        statusBadge = `<span class="text-[10px] bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 px-1.5 py-0.5 rounded-md font-bold">${presentCount}/${totalCount}</span>`;
                    }
                }

                cell.innerHTML = `
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold ${isWeekend ? 'text-rose-400' : 'text-slate-200'}">${day}</span>
                        ${statusBadge}
                    </div>
                    <div class="text-[10px] text-slate-400 truncate font-medium">
                        ${cellData && cellData.sessions ? cellData.sessions.map(s => s.subject).join(', ') : (isWeekend ? 'Weekend' : '')}
                    </div>
                `;
                grid.appendChild(cell);
            }
        }

        function openSessionModal(dateKey, dayNum) {
            selectedDateKey = dateKey;
            document.getElementById('modalDateTitle').innerText = `Attendance for ${monthsNames[currentMonth]} ${dayNum}, ${currentYear}`;
            document.getElementById('sessionModal').classList.remove('hidden');

            const dateObj = new Date(dateKey);
            const dayName = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][dateObj.getDay()];
            const isWeekend = (dateObj.getDay() === 0 || dateObj.getDay() === 6);
            
            if (!attendanceData[dateKey]) {
                const defaultSubjects = (timetablesData[currentUser.division] && timetablesData[currentUser.division][dayName]) || [];
                attendanceData[dateKey] = {
                    status: isWeekend ? 'HOLIDAY' : 'REGULAR',
                    sessions: defaultSubjects.map(sub => ({ subject: sub, present: true }))
                };
            }

            document.getElementById('dayStatusSelect').value = attendanceData[dateKey].status;
            renderSessionsList();
        }

        function closeSessionModal() {
            document.getElementById('sessionModal').classList.add('hidden');
            selectedDateKey = null;
            renderCalendar();
            updateOverallStats();
        }

        function updateDayStatus(status) {
            if (attendanceData[selectedDateKey]) {
                attendanceData[selectedDateKey].status = status;
                if (status !== 'REGULAR') {
                    attendanceData[selectedDateKey].sessions = [];
                } else {
                    const dateObj = new Date(selectedDateKey);
                    const dayName = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][dateObj.getDay()];
                    const defaultSubjects = (timetablesData[currentUser.division] && timetablesData[currentUser.division][dayName]) || ["EM-I", "PCC", "EC"];
                    attendanceData[selectedDateKey].sessions = defaultSubjects.map(sub => ({ subject: sub, present: true }));
                }
                renderSessionsList();
            }
        }

        function renderSessionsList() {
            const container = document.getElementById('sessionsContainer');
            container.innerHTML = '';
            const cellData = attendanceData[selectedDateKey];

            if (cellData.status !== 'REGULAR') {
                container.innerHTML = `<p class="text-xs text-slate-400 py-6 text-center italic font-medium">No lectures scheduled due to active day status (${cellData.status}).</p>`;
                return;
            }

            if (!cellData.sessions || cellData.sessions.length === 0) {
                container.innerHTML = `<p class="text-xs text-slate-400 py-6 text-center italic font-medium">No classes scheduled on this day in timetable template.</p>`;
                return;
            }

            cellData.sessions.forEach((session, index) => {
                const item = document.createElement('div');
                item.className = "flex items-center justify-between p-3.5 bg-slate-900/90 rounded-2xl border border-slate-800 shadow-2xs";
                item.innerHTML = `
                    <span class="text-sm font-bold text-slate-200">Lecture ${index + 1}: ${session.subject}</span>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" ${session.present ? 'checked' : ''} onchange="toggleSessionPresent(${index})" class="sr-only peer">
                        <div class="w-11 h-6 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-gradient-to-r peer-checked:from-indigo-500 peer-checked:to-purple-600"></div>
                        <span class="ml-2.5 text-xs font-bold text-slate-300">${session.present ? 'Present' : 'Absent'}</span>
                    </label>
                `;
                container.appendChild(item);
            });
        }

        function toggleSessionPresent(index) {
            if (attendanceData[selectedDateKey] && attendanceData[selectedDateKey].sessions[index]) {
                attendanceData[selectedDateKey].sessions[index].present = !attendanceData[selectedDateKey].sessions[index].present;
                renderSessionsList();
            }
        }

        function markAllSessions(status) {
            if (attendanceData[selectedDateKey]) {
                attendanceData[selectedDateKey].sessions.forEach(s => s.present = status);
                renderSessionsList();
            }
        }

        function saveDayAttendance() {
            localStorage.setItem('aik_attendance', JSON.stringify(attendanceData));
            closeSessionModal();
        }

        function updateOverallStats() {
            let totalClasses = 0;
            let attendedClasses = 0;

            Object.values(attendanceData).forEach(day => {
                if (day.status === 'REGULAR' && day.sessions) {
                    day.sessions.forEach(s => {
                        totalClasses++;
                        if (s.present) attendedClasses++;
                    });
                }
            });

            const percentage = totalClasses > 0 ? Math.round((attendedClasses / totalClasses) * 100) : 0;
            document.getElementById('overallPercentage').innerText = `${percentage}%`;
            document.getElementById('classesAttendedText').innerText = `${attendedClasses} / ${totalClasses}`;
        }

        function openSummaryModal(type) {
            let totalClasses = 0;
            let attendedClasses = 0;

            Object.values(attendanceData).forEach(day => {
                if (day.status === 'REGULAR' && day.sessions) {
                    day.sessions.forEach(s => {
                        totalClasses++;
                        if (s.present) attendedClasses++;
                    });
                }
            });

            const percentage = totalClasses > 0 ? Math.round((attendedClasses / totalClasses) * 100) : 0;

            document.getElementById('sumModalName').innerText = currentUser ? currentUser.name : '-';
            document.getElementById('sumModalRoll').innerText = `Roll: ${currentUser ? currentUser.rollNo : '-'}`;
            document.getElementById('sumModalDiv').innerText = currentUser ? currentUser.division : '-';
            document.getElementById('sumModalPercentage').innerText = `${percentage}%`;
            document.getElementById('sumModalAttended').innerText = attendedClasses;
            document.getElementById('sumModalTotal').innerText = totalClasses;
            document.getElementById('sumModalProgressBar').style.width = `${percentage}%`;

            const adviceBox = document.getElementById('sumModalAdvice');

            if (percentage >= 75) {
                adviceBox.className = "p-4 rounded-xl bg-emerald-950/60 border border-emerald-800/50 text-emerald-300 text-xs font-semibold flex items-center space-x-3";
                adviceBox.innerHTML = '<i class="fa-solid fa-circle-check text-base text-emerald-400"></i>';
                adviceBox.appendChild(Object.assign(document.createElement('span'), { textContent: "Great job! Your attendance is above the safe 75% threshold." }));
            } else {
                adviceBox.className = "p-4 rounded-xl bg-rose-950/60 border border-rose-800/50 text-rose-300 text-xs font-semibold flex items-center space-x-3";
                adviceBox.innerHTML = '<i class="fa-solid fa-triangle-exclamation text-base text-rose-400"></i>';
                adviceBox.appendChild(Object.assign(document.createElement('span'), { textContent: "Warning: Your attendance is currently below the 75% required quota." }));
            }

            document.getElementById('summaryModal').classList.remove('hidden');
        }

        function closeSummaryModal() {
            document.getElementById('summaryModal').classList.add('hidden');
        }

        function populateSubjectDropdown() {
            const select = document.getElementById('analyticsSubjectSelect');
            select.innerHTML = '<option value="">-- Choose a Subject --</option>';
            
            const divTimetable = timetablesData[currentUser.division] || {};
            const subjectsSet = new Set();
            Object.values(divTimetable).forEach(dayList => {
                dayList.forEach(sub => subjectsSet.add(sub));
            });

            subjectsSet.forEach(sub => {
                const opt = document.createElement('option');
                opt.value = sub;
                opt.innerText = sub;
                opt.className = "bg-slate-900";
                select.appendChild(opt);
            });
        }

        function renderSubjectAnalytics() {
            const subject = document.getElementById('analyticsSubjectSelect').value;
            const detailView = document.getElementById('analyticsDetailView');
            const placeholder = document.getElementById('analyticsPlaceholder');

            if (!subject) {
                detailView.classList.add('hidden');
                placeholder.classList.remove('hidden');
                return;
            }

            placeholder.classList.add('hidden');
            detailView.classList.remove('hidden');

            let subTotal = 0;
            let subAttended = 0;

            Object.values(attendanceData).forEach(day => {
                if (day.status === 'REGULAR' && day.sessions) {
                    day.sessions.forEach(s => {
                        if (s.subject === subject) {
                            subTotal++;
                            if (s.present) subAttended++;
                        }
                    });
                }
            });

            const subPercentage = subTotal > 0 ? Math.round((subAttended / subTotal) * 100) : 0;

            document.getElementById('selectedSubjectName').innerText = subject;
            document.getElementById('selectedSubjectPercentage').innerText = `${subPercentage}%`;
            document.getElementById('statSubjectAttended').innerText = subAttended;
            document.getElementById('statSubjectTotal').innerText = subTotal;
            
            const statusEl = document.getElementById('statSubjectStatus');
            if (subPercentage >= 75) {
                statusEl.innerText = "Safe Zone (≥ 75%)";
                statusEl.className = "text-sm font-bold text-emerald-400 mt-2";
            } else {
                statusEl.innerText = "Attendance Shortage (< 75%)";
                statusEl.className = "text-sm font-bold text-rose-400 mt-2";
            }
        }

        function resetAnalyticsDropdown() {
            document.getElementById('analyticsSubjectSelect').value = "";
            renderSubjectAnalytics();
        }
    </script>
</body>
</html>