    <script>
        // Note: To use your exact image file across Git clones, you can replace the src string above with your uploaded image file path (e.g. src="logo.png") or use this embedded format.
        function toggleTheme() {
            const body = document.body;
            const html = document.getElementById('htmlRoot');
            const icon = document.getElementById('themeIcon');
            if (body.classList.contains('light')) {
                body.classList.remove('light');
                html.classList.remove('light');
                body.className = "bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-900 text-slate-100 min-h-screen flex items-center justify-center p-4 selection:bg-indigo-500 selection:text-white transition-colors duration-300";
                icon.className = "fa-solid fa-moon";
                localStorage.setItem('aik_theme', 'dark');
            } else {
                body.classList.add('light');
                html.classList.add('light');
                body.className = "bg-gradient-to-br from-slate-100 via-indigo-50 to-slate-200 text-slate-900 min-h-screen flex items-center justify-center p-4 selection:bg-indigo-500 selection:text-white transition-colors duration-300";
                icon.className = "fa-solid fa-sun text-amber-500";
                localStorage.setItem('aik_theme', 'light');
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            if (localStorage.getItem('aik_theme') === 'light') {
                toggleTheme();
            }
        });

        document.getElementById('setupForm').addEventListener('submit', (e) => {
            e.preventDefault();
            const user = {
                name: document.getElementById('studentNameInput').value,
                rollNo: document.getElementById('rollNoInput').value,
                division: document.getElementById('divisionInput').value,
                batch: document.getElementById('batchInput').value
            };
            localStorage.setItem('aik_master_user', JSON.stringify(user));
            window.location.href = 'tracker.html';
        });
    </script>
